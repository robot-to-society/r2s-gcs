# /etc/rgcs/config.toml — rgcs-server の起動設定(それ以外の設定は画面から SQLite に保存)
# install.sh はこのファイルが無いときだけ作成し、既存のファイルは上書きしません。

# 待受アドレス(ブラウザは http://<Pi の IP>:8000)
listen = "0.0.0.0:8000"

# FC との接続: Rpanion-server の配信先(既定)。シリアル直結なら "/dev/ttyAMA0,921600" など
mavlink_url = "udpin:127.0.0.1:15555"

# データベース・ロゴ・取り出したログの保存先
data_dir = "/var/lib/rgcs"

role = "standalone"

# MediaMTX の WHEP(MT11 の RTSP を WebRTC 化したもの)
# whep_upstream = "http://127.0.0.1:8889/mt11/whep"

# 地図タイル(現場の契約に合わせて差し替え)
# map_tile_url = "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# map_attribution = "© OpenStreetMap contributors"

# 背景地図の選択肢。[[basemaps]] を 1 つでも書くと既定(map_tile_url の地図・地理院 標準・地理院 写真)を
# すべて置き換えるので、使うものを全部並べる。TOML の配列表なので、トップレベルの項目より後、[ai] より前に置く。
# 衛星写真の例(Esri World Imagery + CARTO の地名ラベル)。どちらも利用条件があり、業務利用には
# 契約やアカウントが要る場合がある。使う前に提供元の規約を確認すること:
#   https://www.esri.com/en-us/legal/terms/full-master-agreement / https://carto.com/basemaps
# [[basemaps]]
# id = "map"
# label = "地図"
# tiles = ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"]
# attribution = "© OpenStreetMap contributors"
# max_zoom = 19
#
# [[basemaps]]
# id = "satellite"
# label = "衛星写真"
# tiles = ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"]
# attribution = "Esri, Maxar, Earthstar Geographics | © CARTO © OpenStreetMap contributors"
# max_zoom = 19
# overlay = ["https://a.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png", "https://b.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png"]
#
# [[basemaps]]
# id = "gsi_photo"
# label = "地理院 写真"
# tiles = ["https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg"]
# attribution = "地理院タイル"
# max_zoom = 18

# 3D 地図の標高タイル (Terrarium 形式)。"" で 3D を無効化 (オフライン現場)
# terrain_tiles = "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"

# プラグイン(地図オーバーレイ・リンク)。<plugins_dir>/<id>/plugin.toml を起動時に読む(PLUGINS.md)
# plugins_dir = "/var/lib/rgcs/plugins"   # 既定は <data_dir>/plugins

# ログ取り出し: auto = tcp/udp と 921600 bps 以上のシリアルで有効
# log_fetch = "auto"

# AI チャット(提案のみ。送信はオペレーターが「実行」を押したときだけ)。既定は無効
# キーはファイルに書かず環境変数で渡す(systemd の EnvironmentFile など、0600)
# [ai]
# provider = "anthropic"            # none | anthropic | openai_compat
# model = "claude-sonnet-5-5"
# api_key_env = "ANTHROPIC_API_KEY"
# daily_token_budget = 2000000      # 直近 24 h のトークン上限(0 = 無制限)
# ローカルの OpenAI 互換サーバー(Ollama など)の例:
# provider = "openai_compat"
# base_url = "http://127.0.0.1:11434/v1"
# model = "qwen3:8b"
