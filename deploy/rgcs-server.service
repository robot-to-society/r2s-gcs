[Unit]
Description=RGCS ground control server (MAVLink + camera + web UI)
After=network-online.target
Wants=network-online.target
# The MT11 accepts one TCP client: never run the Python camera UI at the same time.
Conflicts=mt11-camera-ui.service

[Service]
Type=simple
User=pi
Environment=RGCS_CONFIG=/etc/rgcs/config.toml
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/rgcs-server
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/rgcs

[Install]
WantedBy=multi-user.target
